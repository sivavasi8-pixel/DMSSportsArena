# Neon: pooled string (host has -pooler, add sslmode=require) and the direct string for migrations
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET="change-me-to-a-long-random-string"
WEB_ORIGIN="https://your-service.onrender.com"
# Used once by `npm run seed`
SEED_ADMIN_NAME="Owner"
SEED_ADMIN_MOBILE="9999999999"
SEED_ADMIN_PIN="482916"
